PORT=8787
# Origen de tu página (CORS). Ejemplo: https://tu-sitio.com
ALLOW_ORIGIN=*
# SMTP gratuito: Brevo (300 correos/día gratis), Gmail con contraseña de aplicación, etc.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IA de Desahogo <tu-correo@tu-dominio.com>"
# URL pública de este agente (para el enlace de baja)
PUBLIC_URL=https://tu-agente.example.com
